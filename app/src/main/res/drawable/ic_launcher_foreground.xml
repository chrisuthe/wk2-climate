<?xml version="1.0" encoding="utf-8"?>
<!--
  arcticons:thermostat, from https://icon-sets.iconify.design.

  The source is a 48x48 viewBox; this is a 108x108 adaptive-icon foreground, so
  the glyph is wrapped in a group scaled 1.4x and offset by (108 - 48*1.4)/2 =
  20.4 to centre it. That keeps its ~56-unit height inside the 66dp safe circle
  a launcher mask is allowed to clip to. Group transforms scale before they
  translate, so the offsets are in unscaled viewport units.

  Two changes from the SVG, both forced: the source's <circle> becomes a pair of
  arcs, because VectorDrawable has no circle element, and the implicit SVG
  stroke-width of 1 is stated explicitly. The width is left at 1 deliberately -
  the hairline is what arcticons looks like.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.4"
        android:scaleY="1.4"
        android:translateX="20.4"
        android:translateY="20.4">

        <!-- Body, bulb outline and the four scale ticks. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFF4F4F3"
            android:strokeWidth="1"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M27.387,30.864V7.887a3.387,3.387 0 1 0 -6.774,0v22.977a6.77,6.77 0 0 0 -3.388,5.861a6.775,6.775 0 0 0 13.55,0a6.77,6.77 0 0 0 -3.387,-5.86M24,14.557v-2.826m0,8.326V17.23m0,8.327V22.73m0,11.256V28.23" />

        <!-- The bulb: cx=24 cy=36.725 r=2.74, as two half-arcs. -->
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFF4F4F3"
            android:strokeWidth="1"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M24,33.985a2.74,2.74 0 1 0 0,5.48a2.74,2.74 0 1 0 0,-5.48z" />
    </group>
</vector>
